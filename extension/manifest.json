{
  "manifest_version": 3,
  "name": "Dual Captions for Streaming",
  "description": "Minimal dual-caption MVP for Disney+ and Netflix.",
  "version": "0.1.31",
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://*/*",
    "https://disneyplus.com/*",
    "https://www.disneyplus.com/*",
    "https://*.disneyplus.com/*",
    "https://www.netflix.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/page-translation-bridge.js"
      ],
      "matches": [
        "https://disneyplus.com/*",
        "https://www.disneyplus.com/*",
        "https://www.netflix.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://disneyplus.com/*",
        "https://www.disneyplus.com/*",
        "https://www.netflix.com/*"
      ],
      "js": [
        "src/page-translation-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://disneyplus.com/*",
        "https://www.disneyplus.com/*",
        "https://www.netflix.com/*"
      ],
      "js": [
        "src/disneyplus/parser.js",
        "src/disneyplus/captionStore.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
